{% extends 'layouts/page.njk' %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}

{% block beforeContent %}
  {{ govukBackLink({
    href: backLink
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ heading }}</h1>

      {{ govukSummaryList({
        rows: [
          {
            key: {
              text: "Greeting preference"
            },
            value: {
              text: preference | capitalize
            },
            actions: {
              items: [
                {
                  href: ROUTES.PREFERENCE,
                  text: "Change",
                  visuallyHiddenText: "greeting preference"
                }
              ]
            }
          },
          {
            key: {
              text: "Name"
            },
            value: {
              text: name if name else "Not provided"
            },
            actions: {
              items: [
                {
                  href: ROUTES.NAME,
                  text: "Change",
                  visuallyHiddenText: "name"
                }
              ]
            }
          } if preference === "formal",
          {
            key: {
              text: "Favourite colour"
            },
            value: {
              text: color | capitalize
            },
            actions: {
              items: [
                {
                  href: ROUTES.COLOR,
                  text: "Change",
                  visuallyHiddenText: "favourite colour"
                }
              ]
            }
          }
        ]
      }) }}

      <h2 class="govuk-heading-m">Now complete your journey</h2>

      <p class="govuk-body">
        By submitting this form you are confirming that the information you have provided is correct.
      </p>

      {{ govukButton({
        text: "Accept and complete",
        href: ROUTES.CONFIRMATION
      }) }}
    </div>
  </div>
{% endblock %}
