{% extends 'layouts/page.njk' %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: "nrf-frontend-starter"
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <p class="govuk-body">
        This prototype contains different user journeys that will be trialled with stakeholders. Select a journey below to access the journey.
      </p>

      <table class="govuk-table">
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">User Journey</th>
            <th scope="col" class="govuk-table__header">Description</th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          <tr class="govuk-table__row">
            <td class="govuk-table__cell">
              <a href="/hello-world/hello" class="govuk-link">Hello World Form</a>
            </td>
            <td class="govuk-table__cell">
              This is a sample page to demonstrate the concept of a user journey.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

{% endblock %}
